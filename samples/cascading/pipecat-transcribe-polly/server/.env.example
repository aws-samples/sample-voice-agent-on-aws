# Copy to `.env` and fill in. Pipecat's AWS services read the standard boto3
# credential chain, so you can also use ~/.aws/credentials or AWS_PROFILE / SSO
# instead of the static keys below.

# AWS credentials (omit if you use a profile / SSO / instance role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Region for Transcribe, Bedrock (Nova 2 Lite), and Polly.
# Note: Polly's `generative` engine is only available in some regions. If you
# hit a Polly engine error, set POLLY_ENGINE=neural or switch region.
AWS_REGION=us-east-1

# LLM — Nova 2 Lite cross-region inference profile.
NOVA_MODEL_ID=us.amazon.nova-2-lite-v1:0

# TTS — Polly voice and engine. Generative voices: Ruth, Matthew, Stephen, Amy.
POLLY_VOICE_ID=Ruth
POLLY_ENGINE=generative

# STT — Transcribe language code.
TRANSCRIBE_LANGUAGE=en-US
